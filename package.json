{
  "main": "app/main.js",
  "version": "4.4.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "ng": "ng",
    "start": "concurrently \"npm:electron:serve\" \"npm:ng:serve\"",
    "ng:serve": "ng serve -c dev",
    "ng:web": "ng serve -c web -o",
    "build": "npm run electron:serve-tsc && ng build --base-href ./",
    "build:dev": "npm run build -- -c dev",
    "build:prod": "npm run build -- -c production",
    "web:build": "npm run build -- -c web-production",
    "electron": "electron",
    "electron:serve-tsc": "tsc -p tsconfig.serve.json",
    "electron:serve-tsc:watch": "tsc -p tsconfig.serve.json --watch --preserveWatchOutput",
    "electron:start": "electron . --serve",
    "electron:serve": "wait-on tcp:4200 && npm run electron:serve-tsc && concurrently \"npm:electron:serve-tsc:watch\" \"npm:electron:start\"",
    "electron:local": "npm run build:prod && electron .",
    "electron:build": "npm run build:prod && electron-builder build --publish=never",
    "test": "npm run test:unit && npm run test:migrations && npm run test:result-webhook-main && npm run test:settings-crypto && npm run test:packaged-paths && npm run test:safety-guard && npm run test:upgrade-identity && npm run test:tracked-files && npm run test:audit-gate && npm run test:install-script",
    "test:unit": "ng test --watch=false",
    "test:coverage": "ng test --watch=false --coverage",
    "test:migrations": "node --experimental-sqlite scripts/test-sqlite-migrations.cjs",
    "test:result-webhook-main": "node --experimental-sqlite scripts/test-result-webhook-main.mjs",
    "test:settings-crypto": "node scripts/test-settings-crypto.mjs",
    "test:packaged-paths": "node scripts/test-packaged-paths.mjs",
    "test:safety-guard": "node scripts/test-electron-safety.mjs",
    "test:upgrade-identity": "node scripts/test-upgrade-identity.mjs",
    "test:tracked-files": "node scripts/test-tracked-files.mjs",
    "test:audit-gate": "node scripts/test-audit-gate.mjs",
    "test:install-script": "bash scripts/test-install-script.sh",
    "test:watch": "ng test",
    "verify": "npm run check:safety && npm run lint && npm test && npm run build:prod",
    "security:audit": "node scripts/audit-dependencies.mjs",
    "bump": "node scripts/bump-version.mjs",
    "e2e": "npm run build:prod && playwright test -c e2e/playwright.config.ts e2e/",
    "e2e:show-trace": "playwright show-trace e2e/tracing/trace.zip",
    "version": "conventional-changelog -i CHANGELOG.md -s -r 0 && git add CHANGELOG.md",
    "lint": "ng lint",
    "check:safety": "node scripts/check-electron-safety.mjs",
    "install-hooks": "bash scripts/install-hooks.sh"
  },
  "dependencies": {
    "@angular/animations": "22.1.5",
    "@angular/cdk": "22.1.5",
    "@angular/common": "22.1.5",
    "@angular/compiler": "22.1.5",
    "@angular/core": "22.1.5",
    "@angular/forms": "22.1.5",
    "@angular/language-service": "22.1.5",
    "@angular/material": "22.1.5",
    "@angular/platform-browser": "22.1.5",
    "@angular/platform-browser-dynamic": "22.1.5",
    "@angular/router": "22.1.5",
    "@fortawesome/fontawesome-free": "7.3.1",
    "@vscode/sqlite3": "5.1.14-vscode",
    "electron-log": "5.4.4",
    "electron-store": "^8.2.0",
    "hl7parser": "^1.0.1",
    "moment": "^2.30.1",
    "mysql2": "3.24.3",
    "ngx-pagination": "^6.0.3",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "uuid": "14.0.2",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.2.0",
    "@angular-eslint/eslint-plugin": "22.2.0",
    "@angular-eslint/eslint-plugin-template": "22.2.0",
    "@angular-eslint/schematics": "22.2.0",
    "@angular-eslint/template-parser": "22.2.0",
    "@angular/build": "22.1.7",
    "@angular/cli": "22.1.7",
    "@angular/compiler-cli": "22.1.5",
    "@ngx-translate/core": "18.0.0",
    "@ngx-translate/http-loader": "18.0.0",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "@vitest/coverage-v8": "4.1.11",
    "angular-eslint": "22.2.0",
    "bootstrap": "5.3.8",
    "concurrently": "10.0.5",
    "conventional-changelog-cli": "5.0.0",
    "electron": "44.1.1",
    "electron-builder": "26.15.3",
    "electron-debug": "4.1.0",
    "electron-reloader": "1.2.3",
    "eslint": "10.9.1",
    "eslint-plugin-jsdoc": "64.3.4",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "jsdom": "30.0.1",
    "playwright": "1.62.1",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wait-on": "9.1.0"
  },
  "engines": {
    "node": ">= 22.22.3 || >= 24.15.0"
  },
  "browserslist": [
    "chrome 136"
  ]
}
